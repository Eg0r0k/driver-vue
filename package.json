{
  "name": "driver-vue-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm --filter driver-vue test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck",
    "lint:package": "turbo run lint:package",
    "docs:dev": "pnpm --filter driver-vue-docs dev",
    "docs:build": "turbo run build --filter=driver-vue-docs",
    "play:nuxt": "pnpm --filter nuxt-playground dev",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "turbo": "^2.6.5",
    "typescript": "~5.9.3",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-vue": "^10.11.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "globals": "^17.12.0",
    "vue-tsc": "^3.3.11",
    "vue": "^3.5.43"
  }
}
