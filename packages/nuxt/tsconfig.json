{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "#app": ["./node_modules/nuxt/dist/app"],
      "#imports": ["./node_modules/nuxt/dist/app/composables"]
    }
  },
  "include": ["src/**/*"]
}
